*.h5ad
*.h5
*.rds
*.RData
*.loom
*.mtx
*.mtx.gz
*.bam
*.fastq
*.fastq.gz
*.npz
# editor and runtime noise
.Rhistory
.Rproj.user/
.ipynb_checkpoints/
__pycache__/
slurm-*.out
*.log
