# data and throwaway
data/*
!data/.gitkeep
scratch/*
!scratch/.gitkeep
# analysis outputs, except small derived tables and final figure panels
code/analysis/**/out/*
code/pipeline/**/out/*
!code/analysis/**/out/tables/
!code/analysis/**/out/final/
