# data and throwaway
data/*
!data/.gitkeep
scratch/*
!scratch/.gitkeep
# analysis outputs: tables/, plots/ and reports/ are committed (keep files < 5 MB);
# large intermediates and job logs are not, at any depth (also under out/thru_<batch>/)
code/analysis/**/out/**/objects/
code/analysis/**/out/**/jobs/
code/pipeline/**/out/*
# large binary formats, wherever they appear
*.h5ad
*.h5
*.rds
*.RData
*.loom
*.mtx
*.mtx.gz
*.bam
*.fastq
*.fastq.gz
*.npz
# editor and runtime noise
.Rhistory
.Rproj.user/
.ipynb_checkpoints/
__pycache__/
slurm-*.out
*.log
# per-person Claude Code settings
.claude/settings.local.json
